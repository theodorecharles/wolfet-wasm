+/*
+ * CCHookReloaded aimbot (arcade /cchook), ported off the published source
+ * without the injector: hitscan only, head box then body box, screen-distance
+ * ranking, sticky target while attack is held.
+ */
+#define ETJS_CCHOOK_HEAD_STEP 0.5f
+#define ETJS_CCHOOK_BODY_STEP 0.3f
+
+static qboolean ETJS_CcHookHitscan(int weapon)
+{
+	switch (weapon)
+	{
+	case WP_KNIFE:
+	case WP_KNIFE_KABAR:
+	case WP_LUGER:
+	case WP_COLT:
+	case WP_SILENCER:
+	case WP_SILENCED_COLT:
+	case WP_AKIMBO_COLT:
+	case WP_AKIMBO_LUGER:
+	case WP_AKIMBO_SILENCEDCOLT:
+	case WP_AKIMBO_SILENCEDLUGER:
+	case WP_MP40:
+	case WP_THOMPSON:
+	case WP_STEN:
+	case WP_MP34:
+	case WP_KAR98:
+	case WP_CARBINE:
+	case WP_GARAND:
+	case WP_GARAND_SCOPE:
+	case WP_K43:
+	case WP_K43_SCOPE:
+	case WP_FG42:
+	case WP_FG42_SCOPE:
+	case WP_MOBILE_MG42:
+	case WP_MOBILE_MG42_SET:
+	case WP_MOBILE_BROWNING:
+	case WP_MOBILE_BROWNING_SET:
+		return qtrue;
+	default:
+		return qfalse;
+	}
+}
+
+static qboolean ETJS_CcHookPointVisible(const vec3_t from, const vec3_t pt, int skip)
+{
+	trace_t tr;
+
+	CG_Trace(&tr, from, NULL, NULL, pt, cg.clientNum, MASK_SHOT);
+	return tr.fraction > 0.98f || tr.entityNum == skip;
+}
+
+static qboolean ETJS_CcHookBoxVisible(const vec3_t from, const vec3_t mins, const vec3_t maxs,
+                                      float step, vec3_t visOut, int skip)
+{
+	vec3_t boxSize, scaledMins, scaledMaxs, mid;
+	vec3_t corners[8];
+	float  sd;
+	int    i;
+
+	VectorAdd(mins, maxs, visOut);
+	VectorScale(visOut, 0.5f, visOut);
+	if (ETJS_CcHookPointVisible(from, visOut, skip))
+	{
+		return qtrue;
+	}
+
+	boxSize[0] = Q_fabs(maxs[0] - mins[0]);
+	boxSize[1] = Q_fabs(maxs[1] - mins[1]);
+	boxSize[2] = Q_fabs(maxs[2] - mins[2]);
+
+	for (sd = step; sd < 0.99f; sd += step)
+	{
+		VectorScale(boxSize, -sd * 0.5f, scaledMins);
+		VectorScale(boxSize, sd * 0.5f, scaledMaxs);
+		VectorAdd(scaledMins, visOut, scaledMins);
+		VectorAdd(scaledMaxs, visOut, scaledMaxs);
+
+		VectorSet(corners[0], scaledMaxs[0], scaledMaxs[1], scaledMaxs[2]);
+		VectorSet(corners[1], scaledMaxs[0], scaledMaxs[1], scaledMins[2]);
+		VectorSet(corners[2], scaledMins[0], scaledMaxs[1], scaledMins[2]);
+		VectorSet(corners[3], scaledMins[0], scaledMaxs[1], scaledMaxs[2]);
+		VectorSet(corners[4], scaledMaxs[0], scaledMins[1], scaledMaxs[2]);
+		VectorSet(corners[5], scaledMaxs[0], scaledMins[1], scaledMins[2]);
+		VectorSet(corners[6], scaledMins[0], scaledMins[1], scaledMins[2]);
+		VectorSet(corners[7], scaledMins[0], scaledMins[1], scaledMaxs[2]);
+
+		for (i = 0; i < 7; i++)
+		{
+			VectorAdd(corners[i], corners[i + 1], mid);
+			VectorScale(mid, 0.5f, mid);
+			if (ETJS_CcHookPointVisible(from, mid, skip))
+			{
+				VectorCopy(mid, visOut);
+				return qtrue;
+			}
+		}
+		for (i = 0; i < 8; i++)
+		{
+			if (ETJS_CcHookPointVisible(from, corners[i], skip))
+			{
+				VectorCopy(corners[i], visOut);
+				return qtrue;
+			}
+		}
+	}
+
+	return qfalse;
+}
+
+static qboolean ETJS_CcHookWorldToScreen(const vec3_t point, float *x, float *y)
+{
+	vec3_t trans;
+	float  z, px, py;
+
+	VectorSubtract(point, cg.refdef.vieworg, trans);
+	z = DotProduct(trans, cg.refdef.viewaxis[0]);
+	if (z <= 8.f)
+	{
+		return qfalse;
+	}
+
+	px = tan((double)cg.refdef.fov_x * M_PI / 360.0);
+	py = tan((double)cg.refdef.fov_y * M_PI / 360.0);
+	if (px == 0.f || py == 0.f)
+	{
+		return qfalse;
+	}
+
+	*x = 320.f - DotProduct(trans, cg.refdef.viewaxis[1]) * 320.f / (z * px);
+	*y = 240.f - DotProduct(trans, cg.refdef.viewaxis[2]) * 240.f / (z * py);
+	return qtrue;
+}
+
+static void ETJS_CcHookHeadOffset(const centity_t *cent, vec3_t offset)
+{
+	qboolean moving = VectorLengthSquared(cent->currentState.pos.trDelta) > 1.f;
+
+	/* ET: Legacy head hitbox from CCHookReloaded. */
+	if (cent->currentState.eFlags & (EF_PRONE | EF_PRONE_MOVING))
+	{
+		VectorSet(offset, 0.0f, 0.3f, 6.9f);
+	}
+	else if (cent->currentState.eFlags & EF_CROUCHING)
+	{
+		if (moving)
+		{
+			VectorSet(offset, 0.0f, -0.7f, 7.0f);
+		}
+		else
+		{
+			VectorSet(offset, -0.3f, 0.8f, 7.0f);
+		}
+	}
+	else if (moving)
+	{
+		VectorSet(offset, 0.0f, 0.0f, 6.5f);
+	}
+	else
+	{
+		VectorSet(offset, 0.3f, 0.3f, 7.0f);
+	}
+}
+
+static qboolean ETJS_CcHookEnemy(int clientNum, int localTeam, int enemyTeam)
+{
+	centity_t *cent = &cg_entities[clientNum];
+
+	if (clientNum == cg.clientNum || !cgs.clientinfo[clientNum].infoValid)
+	{
+		return qfalse;
+	}
+	if (!cent->currentValid || cent->currentState.eType != ET_PLAYER ||
+	    (cent->currentState.eFlags & EF_DEAD))
+	{
+		return qfalse;
+	}
+	if (cent->currentState.powerups & (1 << PW_INVULNERABLE))
+	{
+		return qfalse;
+	}
+	if (enemyTeam == TEAM_FREE ||
+	    (cent->currentState.teamNum != enemyTeam &&
+	     cgs.clientinfo[clientNum].team != enemyTeam) ||
+	    cent->currentState.teamNum == localTeam ||
+	    cgs.clientinfo[clientNum].team == localTeam)
+	{
+		return qfalse;
+	}
+	return qtrue;
+}
+
+static qboolean ETJS_CcHookGetAimPos(int clientNum, qboolean head, const vec3_t from, vec3_t aimPos)
+{
+	centity_t    *cent = &cg_entities[clientNum];
+	orientation_t tag;
+	vec3_t        offset, mins, maxs, origin;
+	vec3_t        tagDelta;
+	qboolean      haveTag = qfalse;
+
+	if (CG_GetTag(clientNum, "tag_head", &tag))
+	{
+		haveTag = qtrue;
+	}
+	else if (cent->pe.headRefEnt.hModel)
+	{
+		VectorCopy(cent->pe.headRefEnt.origin, tag.origin);
+		AxisCopy(cent->pe.headRefEnt.axis, tag.axis);
+		VectorSubtract(tag.origin, cent->lerpOrigin, tagDelta);
+		haveTag = VectorLengthSquared(tagDelta) <= Square(128.f);
+	}
+
+	if (head)
+	{
+		if (!haveTag)
+		{
+			return qfalse;
+		}
+
+		ETJS_CcHookHeadOffset(cent, offset);
+		VectorCopy(tag.origin, origin);
+		VectorMA(origin, offset[0], tag.axis[0], origin);
+		VectorMA(origin, offset[1], tag.axis[1], origin);
+		VectorMA(origin, offset[2], tag.axis[2], origin);
+
+		VectorSet(mins, -5.5f, -5.5f, -6.0f);
+		VectorSet(maxs, 5.5f, 5.5f, 6.0f);
+		VectorAdd(mins, origin, mins);
+		VectorAdd(maxs, origin, maxs);
+		return ETJS_CcHookBoxVisible(from, mins, maxs, ETJS_CCHOOK_HEAD_STEP, aimPos, clientNum);
+	}
+
+	VectorCopy(cent->lerpOrigin, origin);
+	VectorSet(mins, -18.f, -18.f, -24.f);
+	VectorSet(maxs, 18.f, 18.f, 48.f);
+	VectorAdd(mins, origin, mins);
+	VectorAdd(maxs, origin, maxs);
+	return ETJS_CcHookBoxVisible(from, mins, maxs, ETJS_CCHOOK_BODY_STEP, aimPos, clientNum);
+}
+
+static int ETJS_CcHookPickTarget(const vec3_t from, int localTeam, int enemyTeam, qboolean head, vec3_t aimPos)
+{
+	int    i, best = -1;
+	float  bestDist = 1e30f;
+	vec3_t localAim;
+	float  x, y, dist;
+
+	for (i = 0; i < MAX_CLIENTS; i++)
+	{
+		if (!ETJS_CcHookEnemy(i, localTeam, enemyTeam))
+		{
+			continue;
+		}
+		if (!ETJS_CcHookGetAimPos(i, head, from, localAim))
+		{
+			continue;
+		}
+		if (!ETJS_CcHookWorldToScreen(localAim, &x, &y))
+		{
+			continue;
+		}
+
+		dist = sqrt((x - 320.f) * (x - 320.f) + (y - 240.f) * (y - 240.f));
+		if (best >= 0 && dist >= bestDist)
+		{
+			continue;
+		}
+		best     = i;
+		bestDist = dist;
+		VectorCopy(localAim, aimPos);
+	}
+
+	return best;
+}
+
+static qboolean ETJS_ApplyHookAim(const vec3_t shooterOrigin, const vec3_t aimPoint, int target, qboolean snapLimit)
+{
+	vec3_t to, ang;
+	int    rawYaw, rawPitch;
+
+	VectorSubtract(aimPoint, shooterOrigin, to);
+	vectoangles(to, ang);
+	if (Q_fabs(AngleNormalize180(ang[PITCH])) > 70.f)
+	{
+		return qfalse;
+	}
+	if (snapLimit &&
+	    Q_fabs(AngleDelta(ang[PITCH], cg.predictedPlayerState.viewangles[PITCH])) > 45.f)
+	{
+		return qfalse;
+	}
+
+	rawYaw   = ANGLE2SHORT(ang[YAW]) - cg.predictedPlayerState.delta_angles[YAW];
+	rawPitch = ANGLE2SHORT(ang[PITCH]) - cg.predictedPlayerState.delta_angles[PITCH];
+	trap_Cvar_Set("etjs_addyaw", va("%f", SHORT2ANGLE(rawYaw)));
+	trap_Cvar_Set("etjs_addpitch", va("%f", SHORT2ANGLE(rawPitch)));
+	trap_Cvar_Set("etjs_aimworldpitch", va("%f", AngleNormalize180(ang[PITCH])));
+	trap_Cvar_Set("etjs_target", va("%d", target));
+	cg.predictedPlayerState.viewangles[YAW]   = ang[YAW];
+	cg.predictedPlayerState.viewangles[PITCH] = ang[PITCH];
+	return qtrue;
+}
+
+static void ETJS_CcHookAim(const vec3_t shooterOrigin)
+{
+	static int etjsCcHookTarget = -1;
+	int        localTeam = cg.snap->ps.teamNum;
+	int        enemyTeam;
+	int        target;
+	vec3_t     aimPoint;
+	qboolean   valid = qfalse;
+
+	if (localTeam != TEAM_AXIS && localTeam != TEAM_ALLIES)
+	{
+		localTeam = cgs.clientinfo[cg.clientNum].team;
+	}
+	enemyTeam = (localTeam == TEAM_AXIS) ? TEAM_ALLIES
+	            : ((localTeam == TEAM_ALLIES) ? TEAM_AXIS : TEAM_FREE);
+
+	if (etjsCcHookTarget >= 0)
+	{
+		if (ETJS_CcHookEnemy(etjsCcHookTarget, localTeam, enemyTeam) &&
+		    (ETJS_CcHookGetAimPos(etjsCcHookTarget, qtrue, shooterOrigin, aimPoint) ||
+		     ETJS_CcHookGetAimPos(etjsCcHookTarget, qfalse, shooterOrigin, aimPoint)))
+		{
+			valid  = qtrue;
+			target = etjsCcHookTarget;
+		}
+	}
+
+	if (!valid)
+	{
+		target = ETJS_CcHookPickTarget(shooterOrigin, localTeam, enemyTeam, qtrue, aimPoint);
+		if (target < 0)
+		{
+			target = ETJS_CcHookPickTarget(shooterOrigin, localTeam, enemyTeam, qfalse, aimPoint);
+		}
+		valid = target >= 0;
+	}
+
+	if (valid && ETJS_ApplyHookAim(shooterOrigin, aimPoint, target, qfalse))
+	{
+		etjsCcHookTarget = target;
+	}
+	else
+	{
+		etjsCcHookTarget = -1;
+	}
+}
